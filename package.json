{
  "name": "match-editor",
  "version": "1.0.0",
  "private": true,
  "description": "足球赛果图编辑器",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --dir dist",
    "dev:api": "wrangler dev --config cloudflare/wrangler.jsonc",
    "deploy:api": "wrangler deploy --config cloudflare/wrangler.jsonc",
    "db:migrate": "wrangler d1 migrations apply match-editor-rosters --remote --config cloudflare/wrangler.jsonc"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "wrangler": "^4.158.0"
  }
}
